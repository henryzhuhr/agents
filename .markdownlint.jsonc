// https://github.com/DavidAnson/vscode-markdownlint#configure
{
    "MD003": {
        "style": "consistent"
    },
    "MD007": {
        "indent": 2
    },
    "MD010": { // no-hard-tabs
        "spaces_per_tab": 4
    },
    "MD013": false,
    "MD024": false, // no-duplicate-heading: Multiple headings with the same content
    "MD033": {
        "allowed_elements": [
            "span",
            "style",
            "sup",
            "del",
            "ins",
            "details",
            "summary",
            "mark",
            "abbr",
            "pre",
            "kbd"
        ]
    },
    "MD040": false,
    "MD060": false
}